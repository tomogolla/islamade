{
  "name": "islamade-storefront",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "imports": {
    "#lib/data/*": "./src/lib/data/*.ts",
    "#lib/utils/legacy": "./src/lib/utils/legacy.js",
    "#lib/utils/*": "./src/lib/utils/*.ts",
    "#lib/components/*": "./src/lib/components/*",
    "#lib/styles/*": "./src/lib/styles/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "catalog": "node tools/build-data.js",
    "test": "node --test test/catalog.test.js",
    "cf:types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.3",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.10.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.68.0"
  }
}
